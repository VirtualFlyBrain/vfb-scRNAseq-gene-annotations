AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:ai") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0015880> "The directed movement of coenzyme A into, out of or within a cell, or between cells, by means of some agent such as a transporter or pore. Coenzyme A, 3'-phosphoadenosine-(5')diphospho(4')pantatheine, is an acyl carrier in many acylation and acyl-transfer reactions in which the intermediate is a thiol ester.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0015880> "coenzyme A transport")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0015880> <http://purl.obolibrary.org/obo/GO_0015748>)
