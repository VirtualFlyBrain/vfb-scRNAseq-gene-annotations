AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0015291> "secondary carrier-type facilitators")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0015291> "secondary active transmembrane transporter activity")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0015291> <http://purl.obolibrary.org/obo/GO_0022804>)

