AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:bf") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0038007> "netrin-mediated signaling pathway")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0038007> "netrin-activated signaling pathway")
