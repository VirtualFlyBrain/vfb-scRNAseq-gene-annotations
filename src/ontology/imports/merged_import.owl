AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0007271> "cholinergic synaptic transmission")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0007271> "synaptic transmission, cholinergic")
