AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0015879> "vitamin Bt transport")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0015879> "carnitine transport")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0015879> <http://purl.obolibrary.org/obo/GO_0015838>)

