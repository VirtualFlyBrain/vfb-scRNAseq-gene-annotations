AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0003810> "fibrinoligase activity")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0003810> "transglutaminase activity")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0003810> "protein-glutamine gamma-glutamyltransferase activity")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0003810> <http://purl.obolibrary.org/obo/GO_0016755>)
