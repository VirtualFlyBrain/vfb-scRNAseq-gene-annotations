AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0016286> "small conductance KCa channels")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0016286> "small conductance calcium-activated potassium channel activity")
SubClassOf(<http://purl.obolibrary.org/obo/GO_0016286> <http://purl.obolibrary.org/obo/GO_0015269>)

